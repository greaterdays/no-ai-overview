{
    "manifest_version": 3,
    "name": "No AI Overview",
    "version": "1.0",
    "description": "Completely removes the Google AI Overview without affecting any other part of your browsing experience.",
    "permissions": [
        "webNavigation",
        "tabs"
    ],
    "host_permissions": [
        "*://*.google.com/search*"
    ],
    "background": {
        "service_worker": "background.js",
        "scripts": ["background.js"]
    },
    "content_scripts": [
        {
            "matches": ["*://*.google.com/search*"],
            "js": ["content.js"],
            "run_at": "document_start"
        }
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "no-ai-overview@greaterdays.com",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    }
}
